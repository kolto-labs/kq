{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "crates/kotor-formats": {
      "release-type": "rust",
      "package-name": "kotor-formats",
      "include-component-in-tag": false
    },
    "crates/kotor-diff": {
      "release-type": "rust",
      "package-name": "kotor-diff",
      "component": "kotor-diff"
    },
    "crates/kotor-ncs-isa": {
      "release-type": "rust",
      "package-name": "kotor-ncs-isa",
      "component": "kotor-ncs-isa"
    },
    "crates/kotor-ncs": {
      "release-type": "rust",
      "package-name": "kotor-ncs",
      "component": "kotor-ncs"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "kotor",
      "components": [
        "kotor-formats",
        "kotor-diff",
        "kotor-ncs-isa",
        "kotor-ncs"
      ]
    }
  ]
}
